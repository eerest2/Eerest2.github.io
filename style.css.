/* High-Visibility, Accessible Styling with Darker Background & New Font */
* {
    box-sizing: border-box;
}

body {
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', sans-serif;
    background-color: #374151; /* Much darker charcoal grey background */
    color: #f3f4f6; /* Bright off-white text for maximum contrast against dark grey */
    margin: 0;
    padding: 0;
    padding-top: 70px; /* Space for the sticky menu */
    font-size: 20px;
}

h1 {
    font-size: 2.5em;
    color: #60a5fa; /* Brighter blue to pop on dark backgrounds */
    text-align: center;
    margin-bottom: 5px;
}

h2 {
    font-size: 2em;
    color: #60a5fa;
    text-align: center;
    border-bottom: 3px solid #60a5fa;
    padding-bottom: 10px;
    margin-top: 40px;
}

p {
    text-align: center;
    line-height: 1.6;
    margin: 15px 10px;
}

.subtitle {
    font-size: 1.2em;
    font-weight: bold;
    color: #d1d5db;
}

/* Persistent Navigation Menu */
.top-menu {
    background-color: #1f2937;
    position: fixed;
    top: 0;
    width: 100%;
    padding: 15px 0;
    text-align: center;
    z-index: 1000;
    border-bottom: 2px solid #4b5563;
}

.top-menu a {
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
    font-size: 1.2em;
    padding: 10px;
}

.top-menu a:hover {
    color: #60a5fa;
    text-decoration: underline;
}

/* Section Spacing */
.section {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 10px;
}

/* Giant Tap-to-Call Button */
.call-button {
    display: block;
    background-color: #dc2626; /* High visibility red */
    color: #ffffff;
    font-size: 1.5em;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    padding: 20px;
    margin: 30px auto;
    border-radius: 10px;
    max-width: 90%;
    box-shadow: 0 4px 6px rgba(0,0,0,0.5);
}

.call-button:hover {
    background-color: #b91c1c;
}

/* Contact Form Styling (Keeping white box for easy form readability) */
.form-container {
    background-color: #ffffff;
    color: #000000;
    padding: 30px;
    margin: 30px auto;
    border: 3px solid #1f2937;
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    max-width: 90%;
}

.form-container h3 {
    text-align: center;
    color: #1f2937;
    margin-top: 0;
    font-size: 1.5em;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
    color: #1f2937;
}

input, textarea {
    width: 100%;
    padding: 15px;
    font-size: 1em;
    border: 2px solid #4b5563;
    border-radius: 8px;
    background-color: #f9fafb;
    color: #000000;
}

input:focus, textarea:focus {
    outline: none;
    border-color: #2563eb;
    background-color: #ffffff;
}

.submit-button {
    display: block;
    width: 100%;
    background-color: #1f2937;
    color: #ffffff;
    font-size: 1.3em;
    font-weight: bold;
    padding: 15px;
    border: none;
    border-radius: 8px;
    margin-top: 30px;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

.submit-button:hover {
    background-color: #111827;
}

/* --- Bottom "Still Building" Footer Notice --- */
.footer-notice {
    background-color: #1f2937;
    border-top: 3px solid #f59e0b; /* Yellow warning accent */
    padding: 25px 20px;
    margin-top: 60px;
    text-align: center;
}

.footer-notice p {
    color: #e5e7eb;
    margin: 0;
    font-size: 1em;
}

.footer-notice a {
    color: #60a5fa;
    font-weight: bold;
    text-decoration: underline;
}

/* Responsive Image Styling */
img {
    display: block;
    margin: 20px auto;
    max-width: 90%;
    height: auto;
    border: 3px solid #1f2937;
    border-radius: 8px;
}