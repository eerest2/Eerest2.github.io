/* High-Visibility, Accessible Styling */
* {
    box-sizing: border-box; /* Ensures padding doesn't break form width */
}

body {
    font-family: Arial, Verdana, sans-serif;
    background-color: #e5e7eb; /* Soft Grey Background */
    color: #000000;
    margin: 0;
    padding: 0;
    padding-top: 70px;
    font-size: 20px;
}

h1 {
    font-size: 2.5em;
    color: #003366;
    text-align: center;
    margin-bottom: 5px;
}

h2 {
    font-size: 2em;
    color: #003366;
    text-align: center;
    border-bottom: 3px solid #003366;
    padding-bottom: 10px;
    margin-top: 40px;
}

p {
    text-align: center;
    line-height: 1.6;
    margin: 15px 10px;
}

.subtitle {
    font-size: 1.2em;
    font-weight: bold;
}

/* Persistent Navigation Menu */
.top-menu {
    background-color: #003366;
    position: fixed;
    top: 0;
    width: 100%;
    padding: 15px 0;
    text-align: center;
    z-index: 1000;
}

.top-menu a {
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
    font-size: 1.2em;
    padding: 10px;
}

.top-menu a:hover {
    text-decoration: underline;
}

/* Section Spacing */
.section {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 10px;
}

/* Giant Tap-to-Call Button */
.call-button {
    display: block;
    background-color: #cc0000;
    color: #ffffff;
    font-size: 1.5em;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    padding: 20px;
    margin: 30px auto;
    border-radius: 10px;
    max-width: 90%;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
}

.call-button:hover {
    background-color: #990000;
}

/* --- New Contact Form Styling --- */
.form-container {
    background-color: #ffffff; /* Crisp white box for contrast */
    padding: 30px;
    margin: 30px auto;
    border: 2px solid #003366;
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    max-width: 90%;
}

.form-container h3 {
    text-align: center;
    color: #003366;
    margin-top: 0;
    font-size: 1.5em;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
}

input, textarea {
    width: 100%;
    padding: 15px;
    font-size: 1em;
    border: 2px solid #6b7280;
    border-radius: 8px;
    background-color: #f9fafb;
}

input:focus, textarea:focus {
    outline: none;
    border-color: #003366;
    background-color: #ffffff;
}

.submit-button {
    display: block;
    width: 100%;
    background-color: #003366;
    color: #ffffff;
    font-size: 1.3em;
    font-weight: bold;
    padding: 15px;
    border: none;
    border-radius: 8px;
    margin-top: 30px;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

.submit-button:hover {
    background-color: #002244;
}

/* Responsive Image Styling */
img {
    display: block;
    margin: 20px auto;
    max-width: 90%;
    height: auto;
    border: 2px solid #000000;
}