body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #e9ecef;
    color: #333;
    margin: 0;
    padding: 0;
}

header {
    background-color: #2b3a42; /* Dark slate tech color */
    color: white;
    padding: 2rem;
    text-align: center;
    border-bottom: 4px solid #007bff; /* Bright blue accent */
}

main {
    max-width: 800px;
    margin: 40px auto;
    padding: 30px;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

h1, h2 {
    color: #2b3a42;
}