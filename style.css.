/* Neon Cyberpunk Accessible Styling */
* {
    box-sizing: border-box;
}

body {
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', sans-serif;
    background-color: #050508; /* Absolute deep space black */
    color: #f3f4f6;
    margin: 0;
    padding: 0;
    padding-top: 80px;
    font-size: 19px;
}

h1 {
    font-size: 2.8em;
    color: #ff007f; /* Neon Hot Pink */
    text-align: center;
    margin-bottom: 5px;
    text-shadow: 0 0 10px rgba(255, 0, 127, 0.6), 0 0 20px rgba(255, 0, 127, 0.3);
}

h2 {
    font-size: 2.2em;
    color: #00f0ff; /* Neon Electric Cyan */
    text-align: center;
    border-bottom: 3px solid #00f0ff;
    padding-bottom: 10px;
    margin-top: 10px;
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
}

p {
    text-align: center;
    line-height: 1.6;
    margin: 15px 10px;
    color: #cbd5e1;
}

.subtitle {
    font-size: 1.25em;
    font-weight: bold;
    color: #39ff14; /* Neon Lime Green */
    text-shadow: 0 0 8px rgba(57, 255, 20, 0.4);
}

.highlight-text {
    color: #ff007f;
    font-weight: bold;
}

/* Persistent Neon Navigation Menu */
.top-menu {
    background-color: #0b0f19;
    position: fixed;
    top: 0;
    width: 100%;
    padding: 15px 0;
    text-align: center;
    z-index: 1000;
    border-bottom: 3px solid #ff007f;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.4);
}

.top-menu a {
    color: #f9fafb;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
    font-size: 1.2em;
    padding: 10px;
    transition: color 0.2s ease;
}

.top-menu a:hover {
    color: #00f0ff;
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.8);
    text-decoration: underline;
}

/* Neon Card Containers */
.card-box {
    background-color: #0b0f19;
    border: 3px solid #00f0ff;
    border-radius: 15px;
    max-width: 850px;
    margin: 30px auto;
    padding: 35px 25px;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.25);
}

/* Service Sub-cards */
.service-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 25px;
}

.service-item {
    background-color: #131b2e;
    border: 2px solid #39ff14; /* Neon lime borders for sub-services */
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.15);
}

.service-item h3 {
    color: #39ff14;
    text-align: center;
    margin-top: 0;
    font-size: 1.3em;
    text-shadow: 0 0 6px rgba(57, 255, 20, 0.4);
}

.service-item p {
    margin-bottom: 0;
    font-size: 0.95em;
}

/* Lesson List Styling */
.lesson-list {
    max-width: 650px;
    margin: 20px auto;
    text-align: left;
    color: #e2e8f0;
    font-size: 1.05em;
    line-height: 1.8;
}

.lesson-list li {
    margin-bottom: 10px;
}

/* Glowing Neon Call Button */
.call-button {
    display: block;
    background-color: #ff007f;
    color: #ffffff;
    font-size: 1.6em;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    padding: 20px;
    margin: 30px auto 10px auto;
    border-radius: 12px;
    border: 3px solid #ff758f;
    max-width: 90%;
    box-shadow: 0 0 20px rgba(255, 0, 127, 0.6);
}

.call-button:hover {
    background-color: #e60073;
    box-shadow: 0 0 30px rgba(255, 0, 127, 0.9);
}

/* Contact Form Styling */
.form-container {
    background-color: #ffffff;
    color: #000000;
    padding: 25px;
    margin: 25px auto;
    border: 3px solid #00f0ff;
    border-radius: 12px;
    max-width: 90%;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
}

.form-container h3 {
    text-align: center;
    color: #0b0f19;
    margin-top: 0;
    font-size: 1.4em;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
    color: #0b0f19;
    font-size: 0.95em;
}

input, textarea {
    width: 100%;
    padding: 12px;
    font-size: 1em;
    border: 2px solid #6b7280;
    border-radius: 8px;
    background-color: #f9fafb;
    color: #000000;
}

input:focus, textarea:focus {
    outline: none;
    border-color: #00f0ff;
    background-color: #ffffff;
}

.submit-button {
    display: block;
    width: 100%;
    background-color: #ff007f;
    color: #ffffff;
    font-size: 1.2em;
    font-weight: bold;
    padding: 14px;
    border: none;
    border-radius: 8px;
    margin-top: 25px;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
}

.submit-button:hover {
    background-color: #e60073;
}

.social-title {
    color: #39ff14;
    text-align: center;
    margin-top: 35px;
    font-size: 1.3em;
    text-shadow: 0 0 6px rgba(57, 255, 20, 0.4);
}

/* Image Sizing Controls */
.image-container img {
    display: block;
    width: 100%;
    max-width: 550px;
    height: auto;
    margin: 20px auto;
    border: 3px solid #00f0ff;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
}

.qr-container img {
    display: block;
    width: 100%;
    max-width: 220px;
    height: auto;
    margin: 15px auto;
    border: 3px solid #39ff14;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(57, 255, 20, 0.3);
}

/* Bottom Footer Notice */
.footer-notice {
    background-color: #0b0f19;
    border-top: 4px solid #ff007f;
    padding: 25px 20px;
    margin-top: 50px;
    text-align: center;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.3);
}

.footer-notice p {
    color: #f9fafb;
    margin: 0;
    font-size: 1em;
}

.footer-notice a {
    color: #00f0ff;
    font-weight: bold;
    text-decoration: underline;
}