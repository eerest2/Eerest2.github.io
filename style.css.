/* Professional High-Visibility Styling */
* {
    box-sizing: border-box;
}

body {
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', sans-serif;
    background-color: #111827; /* Rich dark background */
    color: #f9fafb; /* Crisp text */
    margin: 0;
    padding: 0;
    padding-top: 80px; /* Space for sticky nav */
    font-size: 19px;
}

h1 {
    font-size: 2.6em;
    color: #fbbf24; /* Vibrant Gold */
    text-align: center;
    margin-bottom: 5px;
}

h2 {
    font-size: 2em;
    color: #38bdf8; /* Bright Electric Cyan */
    text-align: center;
    border-bottom: 3px solid #38bdf8;
    padding-bottom: 10px;
    margin-top: 10px;
}

p {
    text-align: center;
    line-height: 1.6;
    margin: 15px 10px;
    color: #e2e8f0;
}

.subtitle {
    font-size: 1.2em;
    font-weight: bold;
    color: #38bdf8;
}

/* Persistent Navigation Menu */
.top-menu {
    background-color: #1f2937;
    position: fixed;
    top: 0;
    width: 100%;
    padding: 15px 0;
    text-align: center;
    z-index: 1000;
    border-bottom: 3px solid #fbbf24;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
}

.top-menu a {
    color: #f9fafb;
    text-decoration: none;
    font-weight: bold;
    margin: 0 20px;
    font-size: 1.2em;
    padding: 10px;
}

.top-menu a:hover {
    color: #fbbf24;
    text-decoration: underline;
}

/* Section Card Containers */
.card-box {
    background-color: #1f2937;
    border: 3px solid #38bdf8;
    border-radius: 15px;
    max-width: 800px;
    margin: 30px auto;
    padding: 35px 25px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
}

/* Giant Tap-to-Call Button */
.call-button {
    display: block;
    background-color: #ef4444;
    color: #ffffff;
    font-size: 1.5em;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    padding: 20px;
    margin: 30px auto 10px auto;
    border-radius: 12px;
    border: 3px solid #fca5a5;
    max-width: 90%;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.call-button:hover {
    background-color: #dc2626;
}

/* Contact Form Styling */
.form-container {
    background-color: #ffffff;
    color: #000000;
    padding: 25px;
    margin: 25px auto;
    border: 3px solid #fbbf24;
    border-radius: 12px;
    max-width: 90%;
}

.form-container h3 {
    text-align: center;
    color: #1f2937;
    margin-top: 0;
    font-size: 1.4em;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
    color: #1f2937;
    font-size: 0.95em;
}

input, textarea {
    width: 100%;
    padding: 12px;
    font-size: 1em;
    border: 2px solid #6b7280;
    border-radius: 8px;
    background-color: #f9fafb;
    color: #000000;
}

input:focus, textarea:focus {
    outline: none;
    border-color: #2563eb;
    background-color: #ffffff;
}

.submit-button {
    display: block;
    width: 100%;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 1.2em;
    font-weight: bold;
    padding: 14px;
    border: none;
    border-radius: 8px;
    margin-top: 25px;
    cursor: pointer;
}

.submit-button:hover {
    background-color: #1d4ed8;
}

.social-title {
    color: #fbbf24;
    text-align: center;
    margin-top: 35px;
    font-size: 1.3em;
}

/* --- Strict Image Sizing Control (Prevents oversized images) --- */
.image-container img {
    display: block;
    width: 100%;
    max-width: 550px; /* Keeps flyer a clean, readable size */
    height: auto;
    margin: 20px auto;
    border: 3px solid #fbbf24;
    border-radius: 10px;
}

.qr-container img {
    display: block;
    width: 100%;
    max-width: 220px; /* Keeps QR code compact and scannable */
    height: auto;
    margin: 15px auto;
    border: 3px solid #fbbf24;
    border-radius: 10px;
}

/* Bottom Footer Notice */
.footer-notice {
    background-color: #1f2937;
    border-top: 4px solid #fbbf24;
    padding: 25px 20px;
    margin-top: 50px;
    text-align: center;
}

.footer-notice p {
    color: #f9fafb;
    margin: 0;
    font-size: 1em;
}

.footer-notice a {
    color: #38bdf8;
    font-weight: bold;
    text-decoration: underline;
}